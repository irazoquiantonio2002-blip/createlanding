# ---- Supabase (datos del negocio + Storage para logo e imagenes) ----
NEXT_PUBLIC_SUPABASE_URL=https://bcgboknagavmluglllun.supabase.co
# Settings -> API Keys -> service_role. NO es la anon key.
# Se queda solo en el servidor: se salta RLS.
SUPABASE_SERVICE_ROLE_KEY=

# ---- n8n ----
N8N_WEBHOOK_URL=https://n8n.agenciahello.com.mx/webhook/generar-landing
N8N_WEBHOOK_TOKEN=

# ---- Claude (lee la imagen publicitaria y saca la descripción) ----
# La misma llave que usa la credencial de Anthropic en n8n, o una nueva de
# console.anthropic.com -> API Keys. Empieza con sk-ant-
ANTHROPIC_API_KEY=

# ---- Accesos ----
# Desarrollador: el dashboard de captura (/)
DEV_PASSWORD=
# Admin: el panel de proyectos (/admin)
ADMIN_PASSWORD=
# Firma las cookies de sesión de los dos. Cualquier string largo y al azar,
# p. ej: openssl rand -hex 32
ADMIN_SESSION_SECRET=
